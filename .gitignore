# dependencies
node_modules/
.pnp
.pnp.js

# build output and image derivatives (regenerated by npm run build)
dist/
public/img/
.cache/

# image masters — never commit full-resolution originals
masters/
*.dng
*.CR2
*.NEF
*.ARW
*.psd
*.tif
*.tiff

# environment and secrets
.env
.env.*
!.env.example
*.pem
.dev.vars

# os / editor
# The one committed workspace file is kept; any other editor workspace
# someone opens here stays out of the repository.
*.code-workspace
!Priscilla.code-workspace
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# dropbox
.dropbox
.dropbox.attr
~$*

# python bytecode
__pycache__/
*.pyc
